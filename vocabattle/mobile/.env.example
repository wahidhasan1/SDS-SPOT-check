# Copy to mobile/.env and fill in. Only PUBLIC values belong here:
# the anon key is designed to ship in apps; Row Level Security protects data.
# NEVER put the service-role key, JWT secret or AI/OCR provider keys in the app.

# Required — Supabase project → Settings → API
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Optional — social sign-in buttons (enable the providers in Supabase Auth first)
# EXPO_PUBLIC_OAUTH_PROVIDERS=google,apple

# Optional — links shown on the subscription and help screens
# EXPO_PUBLIC_TERMS_URL=https://example.com/terms
# EXPO_PUBLIC_PRIVACY_URL=https://example.com/privacy
# EXPO_PUBLIC_SUPPORT_EMAIL=support@example.com
