# ---- Required in production ----
NODE_ENV=production
APP_NAME=FluentPath
DATABASE_URL=postgresql://app:app@localhost:5432/fluentpath
# At least 32 random characters, e.g. `openssl rand -base64 48`
JWT_SECRET=
PUBLIC_WEB_URL=https://app.example.com
CORS_ORIGINS=https://app.example.com
# Comma-separated emails that become admins when they register
ADMIN_EMAILS=

# ---- Voice calls (WebRTC) ----
STUN_URLS=stun:stun.l.google.com:19302
# TURN relay (strongly recommended for reliable calls on mobile networks). See deploy/coturn.
TURN_URLS=turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp,turns:turn.example.com:5349
TURN_SECRET=
CALLING_MINIMUM_AGE=18
MINIMUM_AGE=13

# ---- AI feedback, contextual meanings, translation (optional; Anthropic Claude) ----
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# ---- Server speech-to-text (optional; any OpenAI-compatible /audio/transcriptions endpoint) ----
STT_API_URL=
STT_API_KEY=
STT_MODEL=whisper-1

# ---- Translation without AI (optional; LibreTranslate-compatible) ----
LIBRETRANSLATE_URL=
LIBRETRANSLATE_API_KEY=

# ---- Email (password reset) ----
RESEND_API_KEY=
EMAIL_FROM=FluentPath <no-reply@example.com>

# ---- Billing ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PREMIUM_PRICE_ID=
REVENUECAT_WEBHOOK_AUTH=
REVENUECAT_API_KEY=
REVENUECAT_ENTITLEMENT_ID=premium

# ---- Push notifications (Expo) ----
EXPO_ACCESS_TOKEN=

# ---- Ops ----
# Set to "off" only for single-instance deployments without Postgres LISTEN/NOTIFY
REALTIME_PUBSUB=
AUTH_RATE_LIMIT_PER_MIN=10
