    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^8.3.0",
    "@fastify/websocket": "^11.3.4",
    "@fluentpath/shared": "*",
    "@tesseract.js-data/eng": "^1.0.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.44.7",
    "fastify": "^5.12.7",
    "fastify-plugin": "^5.1.0",
    "nodemailer": "^7.0.13",
    "pg": "^8.23.1",
    "sharp": "^0.34.5",
    "stripe": "^19.3.0",
    "tesseract.js": "^6.0.1",
    "tsx": "^4.23.15",
    "wordnet-db": "^3.1.14",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.2",
    "drizzle-kit": "^0.31.11",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
