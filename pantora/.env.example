# Pantora configuration. Copy to .env.local and fill in what you need.
# Everything is optional: with no variables set, Pantora runs in demo mode.

# ---- App mode -------------------------------------------------------------
# true (default): the preconfigured demo account and demo admin are available.
PANTORA_DEMO_MODE=true

# Require this token for the /admin area. Strongly recommended for anything
# other than a local demo. When unset, /admin is open in demo mode during local
# development only; a production server keeps it closed unless
# PANTORA_OPEN_ADMIN=true (used by the automated tests).
PANTORA_ADMIN_TOKEN=
PANTORA_OPEN_ADMIN=

# Private online test: when set, every page and API call asks for this code
# first, and search engines are told not to index the site. Leave empty locally.
PANTORA_ACCESS_CODE=

# SQLite database file (created automatically). Default: ./.data/pantora.db
# On a server, point this at a persistent disk, e.g. /var/data/pantora.db.
PANTORA_DB_PATH=

# ---- AI feedback (Claude) -------------------------------------------------
# When set, responses are analyzed by Claude on the server. When unset (or if a
# request fails) the transparent rule-based demo analyzer is used and labeled.
ANTHROPIC_API_KEY=
PANTORA_AI_MODEL=claude-opus-5-5
# low | medium | high — lower is faster and cheaper.
PANTORA_AI_EFFORT=low
PANTORA_AI_TIMEOUT_MS=30000

# ---- Speech-to-text (optional) --------------------------------------------
# Any OpenAI-compatible /audio/transcriptions endpoint. Used only when a user
# explicitly sends a recording for transcription.
PANTORA_STT_API_KEY=
PANTORA_STT_BASE_URL=https://api.openai.com/v1
PANTORA_STT_MODEL=whisper-1

# ---- Live matching and voice calls (experimental) -------------------------
# Matches people signed in to this server and connects them with peer-to-peer
# WebRTC audio. Signaling runs through Pantora's API.
PANTORA_LIVE_MATCHING=false
# JSON array of RTCIceServer objects. Add a TURN server for restrictive networks.
PANTORA_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"}]
