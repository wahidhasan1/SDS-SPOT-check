# Copy to .env (repository root or apps/api/.env). Every value is optional in development
# except DATABASE_URL if your Postgres differs from the default below.

# --- Core ---
DATABASE_URL=postgresql://fluent:fluent_dev_pw@localhost:5432/fluent
PORT=4000
# Public URL of the web app (emails, OAuth redirects). In production the API also serves the web app.
APP_URL=http://localhost:5173
# Public URL of the API (OAuth callback). Same as APP_URL in a single-origin production deploy.
API_URL=http://localhost:4000
# Extra allowed browser origins, comma separated.
CORS_ORIGINS=
SESSION_DAYS=30
# Defaults to true when NODE_ENV=production (requires HTTPS).
COOKIE_SECURE=
UPLOAD_DIR=uploads
# Accounts registering with these emails become administrators.
ADMIN_EMAILS=
RATE_LIMIT=true

# --- Email (password reset, notifications). Without it, emails are stored in the outbox and logged. ---
SMTP_URL=
MAIL_FROM=FluentPath <no-reply@example.com>

# --- Google sign-in (optional). Redirect URI: ${API_URL}/api/auth/google/callback ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- AI feedback (writing, speaking, word explanations). Without it, AI features say "not configured". ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# --- Payments (Stripe). Without it, Premium can only be toggled in development mode. ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
# Development-only Premium toggle. Defaults to on outside production; always off when Stripe is configured.
ALLOW_DEV_SUBSCRIPTIONS=

# --- Voice calls (WebRTC). STUN works for most home networks; TURN is needed for strict NAT/corporate networks. ---
STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
TURN_URLS=
# coturn "use-auth-secret" shared secret (preferred: short-lived credentials are generated per user).
TURN_SECRET=
# ...or static TURN credentials.
TURN_USERNAME=
TURN_PASSWORD=
