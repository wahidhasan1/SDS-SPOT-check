{
  "name": "bandmate",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch --env-file-if-exists=.env server/index.ts",
    "dev:web": "vite",
    "build": "tsc -b && vite build && npm run build:server",
    "build:server": "esbuild server/index.ts --bundle --platform=node --format=esm --target=node22 --packages=external --outfile=dist-server/index.js",
    "start": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env dist-server/index.js",
    "typecheck": "tsc -b",
    "test": "node --disable-warning=ExperimentalWarning --import tsx --test 'server/**/*.test.ts'",
    "e2e": "node scripts/e2e/run-all.mjs",
    "models": "./download-models.sh",
    "content:audio": "tsx scripts/generate-audio.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@fastify/cookie": "^11.1.3",
    "@fastify/multipart": "^10.1.3",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/static": "^10.1.6",
    "@fastify/websocket": "^11.3.4",
    "@fontsource-variable/manrope": "^5.3.0",
    "@tanstack/react-query": "^5.104.2",
    "@tesseract.js-data/eng": "^1.0.0",
    "fastify": "^5.12.5",
    "lucide-react": "^1.55.0",
    "nodemailer": "^10.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "sharp": "^0.35.5",
    "sherpa-onnx-node": "^1.13.8",
    "tesseract.js": "^7.0.0",
    "web-push": "^3.6.7",
    "wordnet-db": "^3.1.14",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "esbuild": "^0.28.2",
    "playwright": "^1.64.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
