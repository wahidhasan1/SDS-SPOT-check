{
  "name": "bugloop",
  "version": "0.1.0",
  "private": true,
  "description": "QA ↔ Engineering bug lifecycle platform with an AI bug-report assistant",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build && node scripts/build-server.mjs",
    "build:demo": "node scripts/build-demo.mjs",
    "start": "node --disable-warning=ExperimentalWarning dist/server/index.mjs",
    "seed": "tsx src/server/seed/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "e2e": "node e2e/run.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@hono/node-server": "^2.1.1",
    "@tanstack/react-query": "^5.103.2",
    "hono": "^4.13.9",
    "lucide-react": "^1.48.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^7.18.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "esbuild": "^0.28.2",
    "playwright-core": "1.56.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^5.0.1"
  }
}
