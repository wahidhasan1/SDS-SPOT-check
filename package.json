{
  "name": "fluentpath",
  "private": true,
  "version": "0.1.0",
  "description": "FluentPath — English learning and IELTS preparation platform (web, API, mobile)",
  "workspaces": ["packages/shared", "apps/api", "apps/web"],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build -w apps/web",
    "start": "npm run start -w apps/api",
    "db:migrate": "npm run db:migrate -w apps/api",
    "db:seed": "npm run db:seed -w apps/api",
    "db:setup": "npm run db:migrate && npm run db:seed",
    "admin:promote": "npm run admin:promote -w apps/api --",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test -w apps/api",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "typescript": "5.9.3"
  },
  "engines": { "node": ">=20" }
}
